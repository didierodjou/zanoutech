// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  TEACHER
  STUDENT
  STAFF
}

enum BulletinStatus {
  PENDING
  VERIFIED
  CONFIRMED
}

enum Period {
  TRIMESTER_1
  TRIMESTER_2
  TRIMESTER_3
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum SubjectCategory {
  LITTERAIRE
  SCIENTIFIQUE
}

// ======================================================
// USER
// ======================================================

model User {
  id String @id @default(cuid())

  email        String
  passwordHash String

  role Role

  isActive Boolean @default(true)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  studentProfile Student?
  teacherProfile Teacher?
  staffProfile   Staff?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  meetingParticipants MeetingParticipant[]

  sessions Session[]

  @@unique([email, isDeleted])
  @@index([email])
}

// ======================================================
// SESSION
// ======================================================

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

// ======================================================
// SCHOOL SETTINGS
// ======================================================

model SchoolSetting {
  id String @id @default(cuid())

  schoolName    String
  schoolEmail   String?
  schoolPhone   String?
  schoolAddress String?

  principalName String?
  logo          String?

  currency String @default("FCFA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SCHOOL YEAR
// ======================================================

model SchoolYear {
  id String @id @default(cuid())

  name String @unique

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(false)

  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CLASS
// ======================================================

model Class {
  id String @id @default(cuid())

  name  String
  level String

  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  mainTeacherId String?  @unique
  mainTeacher   Teacher? @relation("MainTeacher", fields: [mainTeacherId], references: [id])

  students Student[]

  courses Course[]

  schedule ScheduleSlot[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolYearId])
  @@index([schoolYearId])
}

// ======================================================
// STUDENT
// ======================================================

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  sex         String?
  dateOfBirth DateTime

  registrationNo String @unique

  photo String?

  parentName  String
  parentPhone String
  parentEmail String?

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  // 📌 Paiement de la scolarité
  tuitionFee       Float?              // montant total dû (ex : 150 000 FCFA)
  tuitionPaid      Float   @default(0) // montant déjà versé
  tuitionStatus    PaymentStatus @default(UNPAID) // état global
  paymentDate      DateTime?           // date du dernier versement
  paymentMethod    String?             // espèces, virement, mobile money…
  paymentReference String?             // n° de transaction ou reçu

  grades      Grade[]
  controls    Control[]
  attendances Attendance[]
  absences    Absence[]
  bulletins   Bulletin[]
  punishments Punishment[]

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

// ======================================================
// TEACHER
// ======================================================

model Teacher {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  phone     String?
  specialty String?
  photo     String?

  subjects Subject[] @relation("TeacherSubjects")

  mainClass Class? @relation("MainTeacher")

  courses  Course[]
  salaries Salary[]

  meetings Meeting[] @relation("Organizer")

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// STAFF
// ======================================================

model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  jobTitle   String
  department String

  hiringDate DateTime @default(now())

  phone String?

  salaries Salary[]

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SUBJECT
// ======================================================

model Subject {
  id String @id @default(cuid())

  name String

  color String?

  category SubjectCategory @default(LITTERAIRE)

  coefficient Float @default(1)

  teachers Teacher[] @relation("TeacherSubjects")

  courses  Course[]
  grades   Grade[]
  controls Control[]

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, isDeleted])
}

// ======================================================
// COURSE
// ======================================================

model Course {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  coefficient Float @default(1)

  scheduleSlots ScheduleSlot[]

  attendances Attendance[]

  absences Absence[]

  controls Control[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, teacherId, classId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

// ======================================================
// CONTROL
// ======================================================

model Control {
  id String @id @default(cuid())

  title String

  type String

  value Float?

  date DateTime @default(now())

  trimester Int

  period Period?

  maxScore Float @default(20)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  grades Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([subjectId])
  @@index([courseId])
  @@index([trimester])
}

// ======================================================
// GRADE
// ======================================================

model Grade {
  id String @id @default(cuid())

  value Float

  coefficient Float @default(1)

  trimester Int

  period Period?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  controlId String?
  control   Control? @relation(fields: [controlId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, subjectId, trimester])
  @@index([studentId])
  @@index([subjectId])
  @@index([trimester])
}

// ======================================================
// ATTENDANCE
// ======================================================

model Attendance {
  id String @id @default(cuid())

  date DateTime @default(now())

  status AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  scheduleSlotId String?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
}

// ======================================================
// ABSENCE
// ======================================================

model Absence {
  id String @id @default(cuid())

  date DateTime @default(now())

  type String

  isJustified Boolean @default(false)

  reason String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  scheduleSlotId String?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

// ======================================================
// SCHEDULE SLOT
// ======================================================

model ScheduleSlot {
  id String @id @default(cuid())

  dayOfWeek Int

  startTime String

  endTime String

  room String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  absences Absence[]

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([courseId])
}

// ======================================================
// BULLETIN
// ======================================================

model Bulletin {
  id String @id @default(cuid())

  period Period

  trimester Int

  status BulletinStatus @default(PENDING)

  generalAverage Float?

  appreciation String?

  conduiteNote Float?

  generatedAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, trimester])
  @@index([studentId])
}

// ======================================================
// PUNISHMENT
// ======================================================

model Punishment {
  id String @id @default(cuid())

  hours Float

  reason String?

  date DateTime @default(now())

  trimester Int

  period Period?

  givenBy String @default("SYSTEM")

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([trimester])
}

// ======================================================
// SALARY
// ======================================================

model Salary {
  id String @id @default(cuid())

  month DateTime

  baseAmount Float

  bonuses Float @default(0)

  deductions Float @default(0)

  netAmount Float

  isPaid Boolean @default(false)

  paymentDate DateTime?

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// MEETING
// ======================================================

model Meeting {
  id String @id @default(cuid())

  title String

  type String

  date DateTime

  duration Int

  location String

  agenda String?

  organizerId String
  organizer   Teacher @relation("Organizer", fields: [organizerId], references: [id])

  participants MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// MEETING PARTICIPANT
// ======================================================

model MeetingParticipant {
  id String @id @default(cuid())

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

// ======================================================
// MESSAGE
// ======================================================

model Message {
  id String @id @default(cuid())

  subject String

  content String

  isUrgent Boolean @default(false)

  read Boolean @default(false)

  groupTarget String?

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String?
  receiver   User?   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
}
